# ============================================================
# WarrantyVault — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================================

# --- Backend ---
NODE_ENV=development

# MongoDB connection string (Docker: use container name 'mongo')
MONGO_URI=mongodb://mongo:27017/warrantyvault

# JWT secret — generate with: node -e "require('crypto').randomBytes(64).toString('hex')|Write-Output"
# Must be at least 32 random characters in production
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# JWT token lifetime
JWT_EXPIRES_IN=7d

# Cookie settings (set to 'true' for HTTPS in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Upload directory (inside container, mapped to Docker volume)
UPLOAD_DIR=/app/uploads

# Max file upload size in bytes (default 5 MB)
MAX_FILE_SIZE=5242880

# Port the backend listens on inside container
PORT=5000

# Allowed CORS origin (dev mode only — in production Nginx handles routing)
CORS_ORIGIN=http://localhost:5173

# --- Frontend (Vite build-time) ---
# Base API URL for Vite dev proxy (leave as /api — proxy is configured in vite.config.js)
VITE_API_BASE=/api
